<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yuzhenghui.kaoyan-vocab-recall</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/yuzhenghui/Library/Application Support/KaoyanVocabRecall/vocab-service.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/yuzhenghui/Library/Application Support/KaoyanVocabRecall</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PORT</key>
    <string>3000</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/yuzhenghui/Library/Logs/KaoyanVocabRecall/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yuzhenghui/Library/Logs/KaoyanVocabRecall/server-error.log</string>
</dict>
</plist>
